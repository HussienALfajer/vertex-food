# Local development settings. Copy to .env (git-ignored) and choose your own passwords; these
# values are fake. The repository is public: never commit a real .env.

# Local PostgreSQL 17 (packages/db). `pnpm db:setup-local` connects with the admin URL (a superuser
# of your local server) and creates the five roles with the passwords below and the database.
DATABASE_ADMIN_URL=postgres://postgres:fake-admin-password@localhost:5432/postgres
# Owner role: runs migrations (`pnpm db:migrate`) and creates the throwaway test databases.
DATABASE_OWNER_URL=postgres://food_owner:fake-owner-password@localhost:5432/vertex_food
# App role: what the apps connect as; row-level security always applies to it.
DATABASE_APP_URL=postgres://food_app:fake-app-password@localhost:5432/vertex_food
# Platform-jobs role: the worker's cross-tenant jobs (outbox dispatch); it cannot bypass RLS and
# every statement it runs is logged.
DATABASE_JOBS_URL=postgres://food_jobs:fake-jobs-password@localhost:5432/vertex_food
# Queue role: apps/worker runs pg-boss with it, in the pgboss schema only.
DATABASE_QUEUE_URL=postgres://food_queue:fake-queue-password@localhost:5432/vertex_food
# Sync role: the sync service (PowerSync) replicates with it; SELECT on published tables only and
# no write, though its REPLICATION attribute reaches further (packages/db/CLAUDE.md, Roles).
DATABASE_SYNC_URL=postgres://food_sync:fake-sync-password@localhost:5432/vertex_food

# apps/api: listens on the loopback address unless told otherwise (a reverse proxy fronts it).
API_HOST=127.0.0.1
API_PORT=3100
# apps/api: browser origins allowed to read its answers (CORS), comma-separated exact origins, no
# wildcard, no cookies. Unset: the restaurant app's Electron renderer (app://restaurant), plus its
# Vite dev and preview servers (http://localhost:5273, http://localhost:4273) unless
# NODE_ENV=production.
# CORS_ORIGINS=app://restaurant
# apps/api: the console's origins (spec S02 rule 41), comma-separated exact origins: console writes
# are accepted from these only. Unset: its Vite dev and preview servers (http://localhost:5274,
# http://localhost:4274), or none when NODE_ENV=production (console writes refused until set).
# CONSOLE_ORIGINS=https://console.example.test
# apps/api identity (spec S02, ADR 0032). These all-zero example keys are refused when
# NODE_ENV=production; for a server generate your own:
#   IDENTITY_HASH_KEY, IDENTITY_ENCRYPTION_KEY: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#   IDENTITY_TOKEN_KEY: node -e "console.log(require('crypto').generateKeyPairSync('ed25519').privateKey.export({format:'der',type:'pkcs8'}).toString('base64'))"
IDENTITY_HASH_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
IDENTITY_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
IDENTITY_TOKEN_KEY=MC4CAQAwBQYDK2VwBCIEIAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
# Leading zero bits of the sign-in proof of work: 18 by default, at least 16 in production.
# IDENTITY_POW_DIFFICULTY=18
# `gateway` queues each code for apps/whatsapp-gateway (spec S03); `fake` (refused in production)
# sends nothing and prints each code with the account id (never the phone) to the API's output.
OTP_SENDER=fake
# apps/api, apps/worker and apps/whatsapp-gateway messaging (spec S03, ADR 0034): recipients
# hashed, recipients, parameters and texts sealed. These all-zero example keys are refused when
# NODE_ENV=production; for a server generate your own, each:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MESSAGING_HASH_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
MESSAGING_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

# apps/worker and apps/whatsapp-gateway: GET /health on loopback ports, for the process manager.
WORKER_PORT=3101
GATEWAY_PORT=3102
