# Local development settings. Copy to .env (git-ignored) and choose your own passwords; these
# values are fake. The repository is public: never commit a real .env.

# Local PostgreSQL 17 (packages/db). `pnpm db:setup-local` connects with the admin URL (a superuser
# of your local server) and creates the five roles with the passwords below and the database.
DATABASE_ADMIN_URL=postgres://postgres:fake-admin-password@localhost:5432/postgres
# Owner role: runs migrations (`pnpm db:migrate`) and creates the throwaway test databases.
DATABASE_OWNER_URL=postgres://food_owner:fake-owner-password@localhost:5432/vertex_food
# App role: what the apps connect as; row-level security always applies to it.
DATABASE_APP_URL=postgres://food_app:fake-app-password@localhost:5432/vertex_food
# Platform-jobs role: the worker's cross-tenant jobs (outbox dispatch); it cannot bypass RLS and
# every statement it runs is logged.
DATABASE_JOBS_URL=postgres://food_jobs:fake-jobs-password@localhost:5432/vertex_food
# Queue role: apps/worker runs pg-boss with it, in the pgboss schema only.
DATABASE_QUEUE_URL=postgres://food_queue:fake-queue-password@localhost:5432/vertex_food
# Sync role: the sync service (PowerSync) replicates with it; SELECT on published tables only and
# no write, though its REPLICATION attribute reaches further (packages/db/CLAUDE.md, Roles).
DATABASE_SYNC_URL=postgres://food_sync:fake-sync-password@localhost:5432/vertex_food
