{
  "name": "vertex-food",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "biome check --error-on-warnings .",
    "lint:fix": "biome check --write .",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "test:electron": "turbo run test:electron",
    "verify": "node scripts/verify.mjs",
    "db:generate": "pnpm --filter @vertex-food/db db:generate",
    "db:migrate": "pnpm --filter @vertex-food/db db:migrate",
    "db:setup-local": "pnpm --filter @vertex-food/db db:setup-local",
    "sync:up": "docker compose -f packages/sync/powersync/docker-compose.yaml --env-file .env up -d",
    "sync:down": "docker compose -f packages/sync/powersync/docker-compose.yaml --env-file .env down"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "24.19.2",
    "@vertex-food/config": "workspace:*",
    "turbo": "2.11.9",
    "typescript": "6.0.3"
  }
}
