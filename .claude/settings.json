{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "opus",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "medium"
    }
  },
  "enabledPlugins": {
    "ui-ux-pro-max@ui-ux-pro-max-skill": false
  },
  "permissions": {
    "defaultMode": "bypassPermissions",
    "allow": [
      "Bash",
      "PowerShell",
      "Read",
      "Edit",
      "Write",
      "WebFetch",
      "WebSearch",
      "Read(D:/vertex-shifa/**)",
      "Read(D:/vertex-hub/**)"
    ],
    "deny": [
      "Read(./spikes/**/out/**)",
      "Read(**/.data/**)",
      "Read(./pnpm-lock.yaml)",
      "Read(**/migrations/meta/**)",
      "Edit(**/migrations/meta/**)",
      "Read(**/routeTree.gen.ts)",
      "Edit(**/routeTree.gen.ts)",
      "Read(**/api-schema.gen.ts)",
      "Edit(**/api-schema.gen.ts)",
      "Read(**/.next/**)",
      "Read(**/dist/**)",
      "Read(**/.turbo/**)",
      "Read(**/.expo/**)",
      "Edit(D:/vertex-shifa/**)",
      "Edit(D:/vertex-hub/**)",
      "Bash(git push --force*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git push -f*)",
      "Bash(gh pr merge * --squash*)",
      "Bash(gh pr merge * --rebase*)",
      "Bash(*drizzle-kit push*)",
      "Bash(*drizzle-kit drop*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.mjs\"",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/cloud-session.sh\"",
            "timeout": 600
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/git-guard.mjs\"",
            "timeout": 15,
            "statusMessage": "Git guard"
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/test-guard.mjs\"",
            "timeout": 30,
            "statusMessage": "Test guard"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/biome-format.mjs\"",
            "timeout": 30,
            "statusMessage": "Biome"
          }
        ]
      }
    ]
  }
}
