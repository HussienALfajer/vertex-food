{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "agentGuidance": false,
  "globalDependencies": [".node-version"],
  "globalPassThroughEnv": ["CI", "NEXT_TELEMETRY_DISABLED"],
  "remoteCache": { "signature": true },
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/brand/**"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/brand/**"],
      "outputs": [],
      "env": ["CI"],
      "passThroughEnv": [
        "DATABASE_OWNER_URL",
        "DATABASE_APP_URL",
        "DATABASE_JOBS_URL",
        "DATABASE_QUEUE_URL",
        "DATABASE_SYNC_URL"
      ]
    },
    "test:e2e": {
      "dependsOn": ["build"],
      "outputs": ["test-results/**"],
      "env": ["CI"],
      "passThroughEnv": ["PLAYWRIGHT_BROWSERS_PATH"]
    }
  }
}
