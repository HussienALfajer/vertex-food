{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "agentGuidance": false,
  "globalDependencies": [".node-version"],
  "globalPassThroughEnv": ["CI"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": [],
      "passThroughEnv": [
        "DATABASE_OWNER_URL",
        "DATABASE_APP_URL",
        "DATABASE_JOBS_URL",
        "DATABASE_QUEUE_URL",
        "DATABASE_SYNC_URL"
      ]
    }
  }
}
